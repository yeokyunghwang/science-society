# ─────────────────────────────────────────────────────────────────────
#  무엇을 추적하는가
#
#  코드(notebooks/, src/)와 최종 지표·그림(results/cp_results/, results/figures/)만
#  추적한다. data/ 아래는 전부 재생성물이다 — data/raw/ 에 원자료를 넣고 노트북 01,
#  src/dysat/train.py, 노트북 03 을 순서대로 돌리면 그대로 복원된다.
#
#  원자료의 위치는 저장소 밖일 수 있다. .env 의 SCISOC_RAW 로 지정한다(.env.example 참조).
# ─────────────────────────────────────────────────────────────────────

# ── 데이터 (전부 재생성물) ────────────────────────────────
/data/*
!/data/raw/
/data/raw/*
!/data/raw/.gitkeep

# ── 결과 ──────────────────────────────────────────────
# core-periphery 그리드 탐색 산출물 1,700개 (26 MB) — 노트북 02가 재생성
/results/cp_results/grid/
# DySAT 학습 로그·체크포인트 — src/dysat/train.py 가 재생성
/results/dysat/

# ── DySAT 자체 테스트 산출물 ────────────────────────────
/src/dysat/synth/
/src/dysat/logs/
/src/dysat/data/

# ── 로컬 전용 ─────────────────────────────────────────
# 이전 버전 보관용 (311 MB, anchor_all.csv 71 MB 포함)
/old/
# 경로 설정은 사람마다 다르다. 예시만 추적한다.
.env
# 발표 자료·압축 파일은 저장소에 두지 않는다 (보고서는 마크다운으로 둔다)
*.pptx
*.zip

# ── 에디터 / OS / 파이썬 ───────────────────────────────
.ipynb_checkpoints/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.DS_Store
.venv/
